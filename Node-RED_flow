        "id": "2471588c80e39d6b",
        "type": "function",
        "z": "1f6f2715d0ae1852",
        "name": "function 3",
        "func": "\nlet cards = global.get(\"cards\");\n\nif (!cards || cards.length === 0) {\n    node.warn(\"No hay cartas cargadas. Ejecuta primero Scryfall.\");\n    return null;\n}\n\nconst messages = [];\n\nfor (const card of cards) {\n\n    const oldPrice = card.price;\n\n    // Variación normal entre -5 % y +5 %\n    let variation = (Math.random() * 10 - 5) / 100;\n\n    // Un 5 % de probabilidad de una variación brusca\n    if (Math.random() < 0.05) {\n        variation = Math.random() < 0.5 ? 0.30 : -0.30;\n    }\n\n    let newPrice = Math.max(\n        0.01,\n        Number((oldPrice * (1 + variation)).toFixed(2))\n    );\n\n    // Actualizar el precio guardado\n    card.price = newPrice;\n\n    messages.push({\n        payload: {\n            card_id: card.card_id,\n            name: card.name,\n            image_url: card.image_url,\n            set: card.set,\n            rarity: card.rarity,\n            price: newPrice,\n            currency: \"EUR\",\n            timestamp: new Date().toISOString(),\n            source: \"simulation\",\n            mode: \"simulated\"\n        }\n    });\n}\n\nglobal.set(\"cards\", cards);\n\nnode.warn(\"Mensajes simulados: \" + messages.length);\n\nreturn [messages];\n",
