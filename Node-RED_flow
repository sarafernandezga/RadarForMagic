    {
        "id": "5f7a57365e011759",
        "type": "function",
        "z": "1f6f2715d0ae1852",
        "name": "function 2",
        "func": "\nconst card = msg.payload;\n\n// Guardamos el último precio conocido de cada carta\nlet lastPrices = context.get(\"lastPrices\") || {};\n\n// Identificamos la carta\nconst id = card.card_id;\nconst newPrice = Number(card.price);\n\n// Validaciones\nif (!id || !Number.isFinite(newPrice) || newPrice <= 0) {\n    return null;\n}\n\n// Primera vez que vemos la carta: guardamos el precio\nif (lastPrices[id] === undefined) {\n    lastPrices[id] = newPrice;\n    context.set(\"lastPrices\", lastPrices);\n    return null;\n}\n\n// Comparamos con el precio anterior\nconst oldPrice = lastPrices[id];\n\nconst changePercent =\n    ((newPrice - oldPrice) / oldPrice) * 100;\n\n// Actualizamos el precio guardado\nlastPrices[id] = newPrice;\ncontext.set(\"lastPrices\", lastPrices);\n\n// Si supera el 20 %, generamos alerta\nif (Math.abs(changePercent) > 20) {\n    msg.key = id;\n    msg.payload = {\n        card_id: id,\n        name: card.name,\n        set: card.set,\n        old_price: oldPrice,\n        new_price: newPrice,\n        currency: card.currency || \"EUR\",\n        change_percent: Number(changePercent.toFixed(2)),\n        image_url: card.image_url || \"\",\n        timestamp: card.timestamp || new Date ().toISOString(),\n        alert: \"PRICE_ANOMALY\"\n    };\n    return msg;\n}\n\nreturn null;\n",
