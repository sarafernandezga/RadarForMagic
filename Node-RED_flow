        "func": "let store = flow.get(\"historyStore\") || {};\nlet selectedId = flow.get(\"selectedCardId\") || null;\n\n// CASE A: user has selected another card to visualize\nif (typeof msg.payload === \"string\") {\n    selectedId = msg.payload;\n    flow.set(\"selectedCardId\", selectedId);\n\n    const cardData = store[selectedId];\n    if (!cardData) return [null, null, null];\n\n    const chartMsg = {\n        topic: `${cardData.name} (${cardData.set.toUpperCase()})`,\n        payload: cardData.points\n    };\n    return [null, chartMsg, null];\n}\n\n// CASE B: card price update\nconst card = msg.payload;\nif (!card || !card.card_id || typeof card.price !== \"number\") {\n    return [null, null, null];\n}\n\nconst id = card.card_id;\nconst timeMs = card.timestamp ? new Date(card.timestamp).getTime() : Date.now();\nlet isNewCard = false;\n\n// if card is new initialize history\nif (!store[id]) {\n    isNewCard = true;\n    store[id] = {\n        card_id: id,\n        name: card.name,\n        set: card.set,\n        initialPrice: card.price,\n        currentPrice: card.price,\n        points: []\n    };\n}\n\n// Price update\nstore[id].currentPrice = card.price;\nstore[id].points.push({ x: timeMs, y: card.price });\nif (store[id].points.length > 50) {\n    store[id].points.shift();\n}\n\n// if there is no card selected, the first one to arrive is selected\nif (!selectedId) {\n    selectedId = id;\n    flow.set(\"selectedCardId\", selectedId);\n}\n\nflow.set(\"historyStore\", store);\n\n// OUTPUT 1: option update\nlet dropdownMsg = null;\nif (isNewCard) {\n    const options = Object.values(store)\n        .map( c=> ({ label: `${c.name} (${c.set.toUpperCase()})`, value: c.card_id}))\n        .sort((a, b) => a.label.localeCompare(b.label));\n    dropdownMsg = { options: options };\n}\n\n// OUTPUT 2: graph update\nlet chartMsg = null;\nif (id === selectedId) {\n    chartMsg = {\n        topic: `${store[id].name} (${store[id].set.toUpperCase()})`,\n        payload: store[id].points\n    };\n}\n\n// OUTPUT 3: Top 10 best rises\nconst ranking = Object.values(store)\n    .map(c => {\n        const diffPct = ((c.currentPrice - c.initialPrice) / c.initialPrice) * 100;\n        return {\n            Card: c.name,\n            Set: c.set.toUpperCase(),\n            \"Initial (€)\": c.initialPrice.toFixed(2),\n            \"Current (€)\": c.currentPrice.toFixed(2),\n            \"Difference (€)\": Number(diffPct.toFixed(2)),\n        };\n    })\n    .sort((a, b) => b[\"Difference (%)\"] - a[\"Difference (%)\"])\n    .slice(0, 10);\n\nconst tableMsg = { payload: ranking };\n\nreturn [dropdownMsg, chartMsg, tableMsg];",
