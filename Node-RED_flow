    {
        "id": "51f0ed30dc7e3126",
        "type": "function",
        "z": "1f6f2715d0ae1852",
        "name": "function 1",
        "func": "\nlet payload = msg.payload;\n\nif (typeof payload === \"string\") {\n    payload = JSON.parse(payload);\n}\n\nif (!payload || !Array.isArray(payload.data)) {\n    node.error(\"No se encuentra el array de cartas\", msg);\n    return null;\n}\n\nconst cards = [];\n\nfor (const card of payload.data) {\n    const price = card.prices?.eur;\n\n    if (price === null || price === undefined || price === \"\") {\n        continue;\n    }\n\n    cards.push({\n        card_id: card.id,\n        name: card.name,\n        image_url: card.image_uris?.normal || card.card_faces?.[0]?.image_uris?.normal || \"\",\n        set: card.set,\n        rarity: card.rarity,\n        price: Number(price),\n        currency: \"EUR\"\n    });\n}\n\n// Guardar las cartas en contexto GLOBAL\nglobal.set(\"cards\", cards);\n\nnode.warn(\"Cartas guardadas: \" + cards.length);\n\nreturn null;\n",
